<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cpp_drone_control</name>
  <version>0.0.0</version>
  <description>MAVROS Implementation of DroneControl to communicate with flight controller.</description>
  <maintainer email="valwerner2@gmail.com">Valentin Werner</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>custom_services</exec_depend>
  <depend>cpp_command</depend>
  <depend>cpp_service_client</depend>
  <depend>cpp_velocity_controller</depend>
  <exec_depend>cpp_inifile</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
